# 開発用の環境変数の例（backend/.env にコピーして使う。backend/.env は Git 管理外）
# cp backend/.env.example backend/.env
# docker-compose.yml の environment に書かれている項目は、そちらが優先されます。

# 判定の要点（Gemini API による文章生成）  詳細: doc/判定の要点生成.md
# 個人情報を扱うため、課金を有効にした Google Cloud プロジェクト（有料枠）のキーだけを使うこと。
# 有料枠のキーであることを確認してから GEMINI_PAID_TIER_CONFIRMED=True にする（False の間は機能が動かない）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PAID_TIER_CONFIRMED=False
SKILL_INSIGHT_ENABLED=True
SKILL_INSIGHT_DAILY_LIMIT=20
GEMINI_TIMEOUT_SECONDS=40

# メール送信（パスワードリセット）  詳細: doc/パスワードリセット.md
# 既定（console）ではメールを送らず、docker compose logs backend に本文を出す。
# yoten.app のメールサーバーから実際に送るときは EMAIL_BACKEND を smtp に切り替え、下の項目を埋める。
# ポート 587 なら EMAIL_USE_TLS=True / EMAIL_USE_SSL=False、465 なら EMAIL_USE_TLS=False / EMAIL_USE_SSL=True
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yoten.app
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yoten.app
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL="陽てん塾 <noreply@yoten.app>"
FRONTEND_URL=http://localhost:3000
PASSWORD_RESET_TIMEOUT=3600
