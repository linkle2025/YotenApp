# 新版（web/）の環境変数の見本。値は入れずにコミットする。
# 手元では web/.env.local にコピーして、ローカルの Supabase（supabase start の表示）の値を入れる。
# Vercel では、検証用（Preview・develop ブランチ）と本番用（Production）に別々の値を設定する。

# Supabase の Project URL（例：https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key（sb_publishable_ で始まる。ブラウザに出てもよい鍵）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key（sb_secret_ で始まる。サーバー側だけで使う。絶対に NEXT_PUBLIC_ を付けない）
SUPABASE_SECRET_KEY=

# ---- 判定の要点（Gemini）----
# Google AI Studio の API キー。必ず課金を有効にしたプロジェクト（有料枠）のキーを使う（Secret として登録）
GEMINI_API_KEY=
# 有料枠のキーであることを確認したら true にする。true でない間は機能が動かない（無料枠は入力が学習に使われることがあるため）
GEMINI_PAID_TIER_CONFIRMED=false
# 使うモデル（省略時 gemini-3.6-flash）
GEMINI_MODEL=
# 機能のオン・オフ（省略時 true）／1人1日の生成回数（省略時 20）／1回のタイムアウト秒（省略時 40）
SKILL_INSIGHT_ENABLED=
SKILL_INSIGHT_DAILY_LIMIT=
GEMINI_TIMEOUT_SECONDS=
