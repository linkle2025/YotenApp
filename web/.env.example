# 新版（web/）の環境変数の見本。値は入れずにコミットする。
# 手元では web/.env.local にコピーして、ローカルの Supabase（supabase start の表示）の値を入れる。
# Vercel では、検証用（Preview・develop ブランチ）と本番用（Production）に別々の値を設定する。

# Supabase の Project URL（例：https://xxxxxxxx.supabase.co）
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key（sb_publishable_ で始まる。ブラウザに出てもよい鍵）
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key（sb_secret_ で始まる。サーバー側だけで使う。絶対に NEXT_PUBLIC_ を付けない）
SUPABASE_SECRET_KEY=
