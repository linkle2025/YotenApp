# 本番環境用環境変数ファイル
# このファイルを .env.prod にコピーして、実際の値を設定してください
# cp .env.prod.example .env.prod

# Django設定
# SECRET_KEYは強力なランダム文字列に変更してください
# 生成方法: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=your-very-secure-secret-key-here-change-this
DEBUG=False
ALLOWED_HOSTS=app.yoten.org
CORS_ALLOWED_ORIGINS=https://app.yoten.org

# データベース設定
DATABASE_NAME=yotenapp
DATABASE_USER=postgres
# DATABASE_PASSWORDは強力なパスワードに変更してください
DATABASE_PASSWORD=your-secure-database-password-here

# フロントエンド設定
REACT_APP_API_URL=https://app.yoten.org/api

# SSL設定（オプション）
SECURE_SSL_REDIRECT=True

# 判定の要点（Gemini API による文章生成）  詳細: doc/判定の要点生成.md
# 個人情報を扱うため、課金を有効にした Google Cloud プロジェクト（有料枠）のキーだけを使うこと。
# 有料枠のキーであることを確認してから GEMINI_PAID_TIER_CONFIRMED=True にする（False の間は機能が動かない）。
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_PAID_TIER_CONFIRMED=False
SKILL_INSIGHT_ENABLED=True
SKILL_INSIGHT_DAILY_LIMIT=20
GEMINI_TIMEOUT_SECONDS=40

# メール送信（パスワードリセット）  詳細: doc/パスワードリセット.md
# yoten.app のメールサーバーの SMTP 情報を設定する。EMAIL_HOST_PASSWORD は Git に入れないこと。
# ポート 587 なら EMAIL_USE_TLS=True / EMAIL_USE_SSL=False、465 なら EMAIL_USE_TLS=False / EMAIL_USE_SSL=True（両方 True は不可）
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.yoten.app
EMAIL_PORT=587
EMAIL_HOST_USER=noreply@yoten.app
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
# 送信元。通常は EMAIL_HOST_USER と同じアドレスにする（違うと送信を拒否するサーバーがある）
DEFAULT_FROM_EMAIL="陽てん塾 <noreply@yoten.app>"
# メール内のリセット用リンクの宛先（本番のフロントエンド URL）と有効期限（秒）
FRONTEND_URL=https://app.yoten.org
PASSWORD_RESET_TIMEOUT=3600
